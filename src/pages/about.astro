---
import MainLayout from "../layouts/MainLayout.astro";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import TextImgRight from "../components/TextImgRight.astro";
import TimeLine from "../components/TimeLine.astro";
import Faq from "../components/Faq.astro";
import TextImgLeft from "../components/TextImgLeft.astro";
import Socials from "../components/Socials.astro";
import SectionDivider from "../components/SectionDivider.astro";
---

<MainLayout title="About us">
  <main class="my-s md:my-l">
    <div class="flex flex-col gap-s md:gap-xl">
      <!-- ***************************** Start About Us ***************************** -->
      <section class="px-2xs md:px-xl whitespace-pre-line">
        <TextImgRight
          image="/img/aboutusbillede.webp"
          imageAlt="About us billede"
          heading="About us"
          text={`At Pool Cph, everything is created with intention. From the interior and overall visual identity to the bar and what’s being served, every detail has been carefully considered. Nothing is random, everything is chosen to support the feeling of the place. 
          
          Our goal is to create the perfect setting for great nights. Whether you're here to play pool, have a drink, or just hang out, Pool Cph is designed to bring people together and make every visit feel special.`}
        />
      </section>
      <!-- ***************************** End About Us ***************************** -->

      <SectionDivider />

      <!-- ***************************** Start History ***************************** -->
      <section class="px-2xs md:px-xl">
        <Heading
          htmlheading="h2"
          size="medium"
          stylingclasses="mb-2xs text-text-dark">The history of pool</Heading
        >
        <TimeLine />
      </section>
      <!-- ***************************** End History ***************************** -->

      <SectionDivider />

      <!-- ***************************** Start Vision and Mission ***************************** -->
      <section class="px-2xs md:px-xl">
        <Heading
          htmlheading="h2"
          size="medium"
          stylingclasses="mb-2xs text-text-dark"
        >
          A New Way to Socialize
        </Heading>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-2xs items-start">
          <div class="scrollzoom flex flex-col gap-2xs overflow-clip">
            <div class="w-full aspect-[16/9] overflow-hidden">
              <img
                src="/img/ourvision.webp"
                alt="Our Vision"
                class="scrollzoomimg w-full h-full object-cover"
              />
            </div>
            <Heading
              htmlheading="h3"
              size="small"
              stylingclasses="text-text-dark"
            >
              Our Vision
            </Heading>
            <Text teksttype="brødtekst" stylingclasses="text-text-dark">
              Pool Cph is a part of <a
                href="https://eve.dk"
                target="_blank"
                rel="noopener noreferrer"
                class="underline">EVE Group</a
              >. Our vision is to push the boundaries within the industry by
              offering new ways of socializing that go beyond drinking. We’re
              here to provide fun experiences that keep you fresh for the next
              morning.
            </Text>
          </div>

          <div class="scrollzoom flex flex-col gap-2xs overflow-clip">
            <div class="w-full aspect-[16/9] overflow-hidden">
              <img
                src="/img/ourmission.webp"
                alt="Our Mission"
                class="scrollzoomimg w-full h-full object-cover"
              />
            </div>
            <Heading
              htmlheading="h3"
              size="small"
              stylingclasses="text-text-dark"
            >
              Our Mission
            </Heading>
            <Text teksttype="brødtekst" stylingclasses="text-text-dark">
              We want to create a space that people can relate to at all times
              of the day. Inclusivity is a key value for us, and we feel that
              it’s missing in the scene. Let’s build lasting connections
              together.
            </Text>
          </div>
        </div>
      </section>
      <!-- ***************************** End Vision and Mission ***************************** -->

      <!-- ***************************** Start FAQ ***************************** -->
      <section class="px-2xs md:px-xl">
        <Faq />
      </section>
      <!-- ***************************** End FAQ ***************************** -->

      <!-- ***************************** Start Location ***************************** -->
      <section class="px-2xs md:px-xl whitespace-pre-line no-border">
        <TextImgLeft
          heading="Location"
          text={`You'll find POOL Cph right in the heart of Copenhagen at Gothersgade 8C, 1123 København, tucked away in a cozy and slightly hidden courtyard.
          
          Set back from the busy street, it feels like your own little oasis, offering a more relaxed and private atmosphere.`}
          ctaLabel=""
          mapSrc="https://maps.google.com/maps?q=Gothersgade%208C%2C%201123%20K%C3%B8benhavn&output=embed"
          mapTitle="POOL Cph - Gothersgade 8C"
        />
      </section>
      <!-- ***************************** End Location ***************************** -->

      <SectionDivider />

      <!-- ***************************** Start Socials ***************************** -->
      <section>
        <Socials />
      </section>
      <!-- ***************************** End Socials ***************************** -->
    </div>
  </main>
</MainLayout>

<script>
  import { animate, scroll } from "motion";

  const scrollZoomSections = document.querySelectorAll(".scrollzoom");

  scrollZoomSections.forEach((section) => {
    const image = section.querySelector(".scrollzoomimg");

    if (!image) return;

    scroll(
      animate(image, {
        scale: [1, 1.3],
      }),
      {
        target: section,
        offset: ["0.75 end", "end end"],
      },
    );
  });
</script>
