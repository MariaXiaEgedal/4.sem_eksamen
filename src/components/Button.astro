---
// Henter parametrene fra Astro.props
const {
  variant = "primary",
  size = "medium",
  id,
  class: className = "",
} = Astro.props;
const variantKey = String(variant);
const sizeKey = String(size);

// Basale styling (fælles)
const base = "rounded-xs transition-all duration-300 ease-out";

// Varianter: bruger jeres token-klasser fra tailwind.css
const variantClasses: Record<string, string> = {
  primary:
    "bg-cta-primary text-text-light px-xs py-4xs hover:px-m hover:shadow-lg",
  secondary:
    "bg-cta-secondary text-text-dark px-xs py-4xs hover:px-m hover:shadow-lg",
  "pool time":
    "bg-transparent border-[length:var(--stroke-xs)] border-primary-beige text-primary-beige px-xs py-4xs hover:bg-primary-beige hover:text-text-dark",
};

const selectedVariant = variantClasses[variantKey] || variantClasses.primary;

// Størrelse (kun tekst-størrelse)
const sizeClasses: Record<string, string> = {
  large: "text-[16px] md:text-[22px]",
  medium: "text-[16px] md:text-[22px]",
  small: "text-[16px] md:text-[22px]",
};

const selectedSize = sizeClasses[sizeKey] || sizeClasses.medium;
---

<!-- Sæt classes for den pågældende knap sammen ved hjælp af Astros class:list -->
<button
  id={id}
  data-button-variant={variantKey === "pool time" ? "pool-time" : null}
  class:list={[base, selectedVariant, selectedSize, className]}><slot /></button
>

<script>
  const poolTimeButtons = document.querySelectorAll(
    '[data-button-variant="pool-time"]',
  );

  poolTimeButtons.forEach((button) => {
    button.addEventListener("click", () => {
      button.classList.add("bg-primary-beige", "text-text-dark");
      button.classList.remove("bg-transparent", "text-primary-beige");
    });
  });
</script>
