---
// Henter parametrene fra Astro.props
const { teksttype = "brødtekst", stylingclasses = "" } = Astro.props;

//Definer den styling (Tailwind classes), der gør sig gældende for de forskellige størrelser.
const sizeClasses = {
  brødtekst: "text-[16px] md:text-[22px]",
  brødtekst_bold: "text-[16px] md:text-[22px]",
  brødtekst_bold_italic: "text-[16px] md:text-[22px]",
  brødtekst_lille: "text-[15px] md:text-[18px] leading-[1.2]",
};

// Font-klasser for de forskellige tekst-typer
const fontClasses = {
  brødtekst: "font-sans font-normal",
  brødtekst_bold: "font-sans font-bold",
  brødtekst_bold_italic: "font-sans font-bold italic underline",
  brødtekst_lille: "font-sans font-normal",
};
---

<p
  class:list={[sizeClasses[teksttype], fontClasses[teksttype], stylingclasses]}
>
  <slot />
</p>
