---
import MainLayout from "../layouts/MainLayout.astro";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import Link from "../components/Link.astro";
import Button from "../components/Button.astro";
import { Image } from "astro:assets";
import thumbsup from "../assets/images/thumbsup.png";
import EventCard from "../components/EventCard.astro";
import EventCardIndex from "../components/EventCardIndex.astro";
import Faq from "../components/Faq.astro";
import MenuCard from "../components/MenuCard.astro";
import Socials from "../components/Socials.astro";
import TextImgLeft from "../components/TextImgLeft.astro";
import TextImgRight from "../components/TextImgRight.astro";
import TimeLine from "../components/TimeLine.astro";
import Event from "./event.astro";
---

<MainLayout title="Komponentbibliotek">
  <main>
    <!-- ***************************** Start intro ***************************** -->
    <div class="px-2xs md:px-xl">
      <Heading htmlheading="h1" size="large" stylingclasses="text-text-dark"
        >Komponent bibliotek</Heading
      >
      <Text teksttype="brødtekst_bold" stylingclasses="text-text-dark"
        >Komponent bibliotek til 4.semesters afsluttende eksamensopgave - Pool
        CPH</Text
      >
    </div>
    <!-- ***************************** End intro ***************************** -->

    <!-- ***************************** Start typography ***************************** -->
    <div class="px-2xs md:px-xl">
      <Heading
        htmlheading="h4"
        size="xsmall"
        stylingclasses="mt-12 text-text-dark"
        >Typografier: (Her kan vi se hvordan vi skal bruge komponenter når vi
        skal skrive noget der er P eller H'er)</Heading
      >

      <Heading htmlheading="h1" size="large" stylingclasses="text-text-dark"
        >Eksempel på en H1</Heading
      >
      <Heading htmlheading="h2" size="medium" stylingclasses="text-text-dark"
        >Eksempel på en H2</Heading
      >
      <Heading htmlheading="h3" size="small" stylingclasses="text-text-dark"
        >Eksempel på en H3</Heading
      >
      <Heading htmlheading="h4" size="xsmall" stylingclasses="text-text-dark"
        >Eksempel på en H4</Heading
      >
      <Heading
        htmlheading="h5"
        size="xsmallbold"
        stylingclasses="text-text-dark">Eksempel på en H5</Heading
      >

      <Text teksttype="brødtekst_bold" stylingclasses="mt-12 text-text-dark"
        >Eksempel på brødtekst-bold</Text
      >

      <Text
        teksttype="brødtekst_bold_italic"
        stylingclasses="mt-2 text-text-dark"
        >Eksempel på brødtekst-italic-bold</Text
      >
      <Text teksttype="brødtekst" stylingclasses="mt-2 text-text-dark"
        >Eksempel på brødtekst: Lorem ipsum dolor sit amet consectetur
        adipisicing elit. Obcaecati neque quam animi nihil sequi officiis
        inventore nisi odit maiores? Quibusdam excepturi laboriosam est
        praesentium magnam vitae consectetur facilis accusamus ipsa!</Text
      >
      <Text teksttype="brødtekst_lille" stylingclasses="mt-2 text-text-dark"
        >Eksempel på brødtekst-lille</Text
      >
    </div>
    <!-- ***************************** End typography ***************************** -->

    <!-- ***************************** Start Buttons ***************************** -->
    <div class="px-2xs md:px-xl">
      <section class="mt-12">
        <Heading
          htmlheading="h4"
          size="xsmall"
          stylingclasses="mb-4 text-text-dark"
          >Buttons: (Her kan vi se hvordan knapperne skal bruges i de
          forskellige komponenter. Der skal nok laves flere varianter)</Heading
        >

        <div class="flex items-center gap-2xs">
          <Button variant="primary" size="medium">Primær CTA</Button>
          <Button variant="secondary" size="medium">Sekundær CTA</Button>
        </div>
      </section>
    </div>
    <!-- ***************************** End Buttons ***************************** -->

    <!-- ***************************** Start Alle Komponenter ***************************** -->
    <Heading
      htmlheading="h4"
      size="xsmall"
      stylingclasses="mt-12 mb-4 text-text-dark px-2xs md:px-xl"
      >Komponenter: (Her kan vi se alle komponenter, mens vi arbejder på dem)</Heading
    >
    <div class="flex flex-col gap-s md:gap-l">
      <section class="bg-red-500 px-2xs md:px-xl">
        <Heading
          htmlheading="h5"
          size="xsmallbold"
          stylingclasses="mb-4 text-text-dark">Komponetent: EventCard</Heading
        >
        <EventCard />
      </section>

      <section class="bg-red-500 px-2xs md:px-xl">
        <Heading
          htmlheading="h5"
          size="xsmallbold"
          stylingclasses="mb-4 text-text-dark"
          >Komponetent: EventCardIndex</Heading
        >
        <EventCardIndex />
      </section>

      <section class="bg-red-500 px-2xs md:px-xl">
        <Heading
          htmlheading="h5"
          size="xsmallbold"
          stylingclasses="mb-4 text-text-dark">Komponetent: Faq</Heading
        >
        <Faq />
      </section>

      <section class="bg-red-500 px-2xs md:px-xl">
        <Heading
          htmlheading="h5"
          size="xsmallbold"
          stylingclasses="mb-4 text-text-dark">Komponetent: MenuCard</Heading
        >
        <MenuCard />
      </section>

      <section class="bg-red-500">
        <Heading
          htmlheading="h5"
          size="xsmallbold"
          stylingclasses="mb-4 text-text-dark">Komponetent: Socials</Heading
        >
        <Socials />
      </section>

      <section class="bg-red-500 px-2xs md:px-xl">
        <Heading
          htmlheading="h5"
          size="xsmallbold"
          stylingclasses="mb-4 text-text-dark">Komponetent: TextImgLeft</Heading
        >
        <TextImgLeft />
      </section>

      <section class="bg-red-500 px-2xs md:px-xl">
        <Heading
          htmlheading="h5"
          size="xsmallbold"
          stylingclasses="mb-4 text-text-dark"
          >Komponetent: TextImgRight</Heading
        >
        <TextImgRight />
      </section>

      <section class="bg-red-500 px-2xs md:px-xl">
        <Heading
          htmlheading="h5"
          size="xsmallbold"
          stylingclasses="mb-4 text-text-dark">Komponetent: TimeLine</Heading
        >
        <TimeLine />
      </section>
    </div>
    <!-- ***************************** End Alle Komponenter ***************************** -->

    <!-- ***************************** Start color palette ***************************** -->
    <div class="px-2xs md:px-xl">
      <Heading
        htmlheading="h4"
        size="xsmall"
        stylingclasses="mt-12 mb-4 text-text-dark">Farvepalette:</Heading
      >
      <!-- Base -->
      <section class="mb-12">
        <Heading
          htmlheading="h5"
          size="xsmallbold"
          stylingclasses="mb-4 text-text-dark">Base</Heading
        >
        <div class="text-center">
          <div class="h-24 bg-base rounded mb-2 border border-primary-red">
          </div>
          <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
            >Baige</Text
          >
        </div>
      </section>

      <!-- Primary Colors -->
      <section class="mb-12">
        <Heading
          htmlheading="h5"
          size="xsmallbold"
          stylingclasses="mb-4 text-text-dark">Primary Colors</Heading
        >
        <div class="grid grid-cols-5 gap-4">
          <div class="text-center">
            <div
              class="h-24 bg-primary-beige rounded mb-2 border border-primary-red"
            >
            </div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >primary-baige (100)</Text
            >
          </div>
          <div class="text-center">
            <div class="h-24 bg-primary-red rounded mb-2"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >primary-red (900)</Text
            >
          </div>
        </div>
      </section>

      <!-- Baige -->
      <section class="mb-12">
        <Heading
          htmlheading="h5"
          size="xsmallbold"
          stylingclasses="mb-4 text-text-dark">Beige</Heading
        >
        <div class="grid grid-cols-11 gap-2">
          <div class="text-center">
            <div class="h-16 bg-beige-50 rounded mb-1"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >50</Text
            >
          </div>
          <div class="text-center">
            <div class="h-16 bg-beige-100 rounded mb-1"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >100</Text
            >
          </div>
          <div class="text-center">
            <div class="h-16 bg-beige-200 rounded mb-1"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >200</Text
            >
          </div>
          <div class="text-center">
            <div class="h-16 bg-beige-300 rounded mb-1"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >300</Text
            >
          </div>
          <div class="text-center">
            <div class="h-16 bg-beige-400 rounded mb-1"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >400</Text
            >
          </div>
          <div class="text-center">
            <div class="h-16 bg-beige-500 rounded mb-1"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >500</Text
            >
          </div>
          <div class="text-center">
            <div class="h-16 bg-beige-600 rounded mb-1"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >600</Text
            >
          </div>
          <div class="text-center">
            <div class="h-16 bg-beige-700 rounded mb-1"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >700</Text
            >
          </div>
          <div class="text-center">
            <div class="h-16 bg-beige-800 rounded mb-1"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >800</Text
            >
          </div>
          <div class="text-center">
            <div class="h-16 bg-beige-900 rounded mb-1"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >900</Text
            >
          </div>
          <div class="text-center">
            <div class="h-16 bg-beige-950 rounded mb-1"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >950</Text
            >
          </div>
        </div>
      </section>

      <!-- Red -->
      <section class="mb-12">
        <Heading
          htmlheading="h5"
          size="xsmallbold"
          stylingclasses="mb-4 text-text-dark">Red</Heading
        >
        <div class="grid grid-cols-11 gap-2">
          <div class="text-center">
            <div class="h-16 bg-red-50 rounded mb-1"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >50</Text
            >
          </div>
          <div class="text-center">
            <div class="h-16 bg-red-100 rounded mb-1"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >100</Text
            >
          </div>
          <div class="text-center">
            <div class="h-16 bg-red-200 rounded mb-1"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >200</Text
            >
          </div>
          <div class="text-center">
            <div class="h-16 bg-red-300 rounded mb-1"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >300</Text
            >
          </div>
          <div class="text-center">
            <div class="h-16 bg-red-400 rounded mb-1"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >400</Text
            >
          </div>
          <div class="text-center">
            <div class="h-16 bg-red-500 rounded mb-1"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >500</Text
            >
          </div>
          <div class="text-center">
            <div class="h-16 bg-red-600 rounded mb-1"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >600</Text
            >
          </div>
          <div class="text-center">
            <div class="h-16 bg-red-700 rounded mb-1"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >700</Text
            >
          </div>
          <div class="text-center">
            <div class="h-16 bg-red-800 rounded mb-1"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >800</Text
            >
          </div>
          <div class="text-center">
            <div class="h-16 bg-red-900 rounded mb-1"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >900</Text
            >
          </div>
          <div class="text-center">
            <div class="h-16 bg-red-950 rounded mb-1"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >950</Text
            >
          </div>
        </div>
      </section>

      <!-- Semantic tokens -->
      <section class="mb-12">
        <Heading
          htmlheading="h5"
          size="xsmallbold"
          stylingclasses="mb-4 text-text-dark">Semantic tokens</Heading
        >
        <div class="grid grid-cols-6 gap-4">
          <div class="text-center">
            <div
              class="h-16 rounded mb-1 bg-background-primary border border-primary-red"
            >
            </div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >background-primary</Text
            >
          </div>

          <div class="text-center">
            <div class="h-16 rounded mb-1 bg-text-dark"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >text-dark</Text
            >
          </div>

          <div class="text-center">
            <div
              class="h-16 rounded mb-1 bg-text-light border border-primary-red"
            >
            </div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >text-light</Text
            >
          </div>

          <div class="text-center">
            <div class="h-16 rounded mb-1 bg-cta-primary"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >cta-primary</Text
            >
          </div>

          <div class="text-center">
            <div
              class="h-16 rounded mb-1 bg-cta-secondary border border-primary-red"
            >
            </div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >cta-secondary</Text
            >
          </div>

          <div class="text-center">
            <div class="h-16 rounded mb-1 bg-primary-line"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >primary-line</Text
            >
          </div>
        </div>

        <div class="grid grid-cols-6 gap-4 mt-6">
          <div class="text-center">
            <div class="h-16 rounded mb-1 bg-logo-1"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >logo-1</Text
            >
          </div>

          <div class="text-center">
            <div class="h-16 rounded mb-1 bg-logo-2 border border-primary-red">
            </div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >logo-2</Text
            >
          </div>

          <div class="text-center">
            <div class="h-16 rounded mb-1 bg-icon"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >icon</Text
            >
          </div>

          <div class="text-center">
            <div class="h-16 rounded mb-1 bg-arrow-dark"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >arrow-dark</Text
            >
          </div>

          <div class="text-center">
            <div
              class="h-16 rounded mb-1 bg-arrow-light border border-primary-red"
            >
            </div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >arrow-light</Text
            >
          </div>
        </div>
      </section>

      <!-- Header og Footer -->
      <section class="mb-12">
        <Heading
          htmlheading="h5"
          size="xsmallbold"
          stylingclasses="mb-4 text-text-dark">Header og Footer</Heading
        >
        <div class="grid grid-cols-2 gap-4">
          <div class="text-center">
            <div class="h-16 rounded mb-1 bg-header"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >header</Text
            >
          </div>

          <div class="text-center">
            <div class="h-16 rounded mb-1 bg-footer"></div>
            <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
              >footer</Text
            >
          </div>
        </div>
      </section>
    </div>
    <!-- ***************************** End color palette ***************************** -->

    <!-- ***************************** Start Spacing ***************************** -->
    <div class="px-2xs md:px-xl">
      <Heading
        htmlheading="h4"
        size="xsmall"
        stylingclasses="mb-4 text-text-dark">Spacing:</Heading
      >
      <section class="">
        <div class="grid grid-cols-6 gap-2xs">
          <div class="text-center">
            <div class="mb-2">
              <div class="h-0 bg-primary-red mb-2"></div>
              <Text
                teksttype="brødtekst_lille"
                stylingclasses="font-bold text-text-dark">0px</Text
              >
              <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
                >0</Text
              >
            </div>
          </div>
          <div class="text-center">
            <div class="">
              <div class="h-5xs bg-primary-red mb-2"></div>
              <Text
                teksttype="brødtekst_lille"
                stylingclasses="font-bold text-text-dark">5px</Text
              >
              <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
                >5xs</Text
              >
            </div>
          </div>
          <div class="text-center">
            <div class="">
              <div class="h-4xs bg-primary-red mb-2"></div>
              <Text
                teksttype="brødtekst_lille"
                stylingclasses="font-bold text-text-dark">10px</Text
              >
              <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
                >4xs</Text
              >
            </div>
          </div>
          <div class="text-center">
            <div class="">
              <div class="h-3xs bg-primary-red mb-2"></div>
              <Text
                teksttype="brødtekst_lille"
                stylingclasses="font-bold text-text-dark">15px</Text
              >
              <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
                >3xs</Text
              >
            </div>
          </div>
          <div class="text-center">
            <div class="">
              <div class="h-2xs bg-primary-red mb-2"></div>
              <Text
                teksttype="brødtekst_lille"
                stylingclasses="font-bold text-text-dark">20px</Text
              >
              <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
                >2xs</Text
              >
            </div>
          </div>
          <div class="text-center">
            <div class="">
              <div class="h-xs bg-primary-red mb-2"></div>
              <Text
                teksttype="brødtekst_lille"
                stylingclasses="font-bold text-text-dark">30px</Text
              >
              <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
                >xs</Text
              >
            </div>
          </div>
        </div>
        <div class="grid grid-cols-6 gap-2xs mt-4">
          <div class="text-center">
            <div class="">
              <div class="h-s bg-primary-red mb-2"></div>
              <Text
                teksttype="brødtekst_lille"
                stylingclasses="font-bold text-text-dark">40px</Text
              >
              <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
                >s</Text
              >
            </div>
          </div>
          <div class="text-center">
            <div class="">
              <div class="h-m bg-primary-red mb-2"></div>
              <Text
                teksttype="brødtekst_lille"
                stylingclasses="font-bold text-text-dark">50px</Text
              >
              <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
                >m</Text
              >
            </div>
          </div>
          <div class="text-center">
            <div class="">
              <div class="h-l bg-primary-red mb-2"></div>
              <Text
                teksttype="brødtekst_lille"
                stylingclasses="font-bold text-text-dark">80px</Text
              >
              <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
                >l</Text
              >
            </div>
          </div>
          <div class="text-center">
            <div class="">
              <div class="h-xl bg-primary-red mb-2"></div>
              <Text
                teksttype="brødtekst_lille"
                stylingclasses="font-bold text-text-dark">100px</Text
              >
              <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
                >xl</Text
              >
            </div>
          </div>
          <div class="text-center">
            <div class="">
              <div class="h-2xl bg-primary-red mb-2"></div>
              <Text
                teksttype="brødtekst_lille"
                stylingclasses="font-bold text-text-dark">150px</Text
              >
              <Text teksttype="brødtekst_lille" stylingclasses="text-text-dark"
                >2xl</Text
              >
            </div>
          </div>
        </div>
      </section>
      <!-- ***************************** End Spacing ***************************** -->

      <!-- ***************************** Start Stroke ***************************** -->
      <Heading
        htmlheading="h4"
        size="xsmall"
        stylingclasses="mt-12 mb-4 text-text-dark">Stroke:</Heading
      >
      <section class="">
        <div class="flex gap-2xs">
          <div class="">
            <div
              class="w-45 h-25 border-primary-red mb-2"
              style="border-width: var(--stroke-xs);"
            >
            </div>
            <Text
              teksttype="brødtekst_lille"
              stylingclasses="text-center font-bold text-text-dark">2px</Text
            >
            <Text
              teksttype="brødtekst_lille"
              stylingclasses="text-center text-text-dark">--stroke-xs</Text
            >
          </div>

          <div class="">
            <div
              class="w-45 h-25 border-primary-red mb-2"
              style="border-width: var(--stroke-s);"
            >
            </div>
            <Text
              teksttype="brødtekst_lille"
              stylingclasses="text-center font-bold text-text-dark">4px</Text
            >
            <Text
              teksttype="brødtekst_lille"
              stylingclasses="text-center text-text-dark">--stroke-s</Text
            >
          </div>
        </div>
      </section>
      <!-- ***************************** End Stroke ***************************** -->

      <!-- ***************************** Start Border Radius ***************************** -->
      <Heading
        htmlheading="h4"
        size="xsmall"
        stylingclasses="mt-12 mb-4 text-text-dark">Border Radius:</Heading
      >
      <section class="mb-12">
        <div class="flex w-45 flex-col items-center">
          <div class="w-45 h-25 rounded-xs bg-primary-red mb-2"></div>
          <Text
