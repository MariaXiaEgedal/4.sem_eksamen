---
import MainLayout from "../layouts/MainLayout.astro";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import TextImgLeft from "../components/TextImgLeft.astro";
import TextImgRight from "../components/TextImgRight.astro";
import EventCard from "../components/EventCard.astro";
import Socials from "../components/Socials.astro";
import SectionDivider from "../components/SectionDivider.astro";
import Bookingoverlay from "../components/Bookingoverlay.astro";
---

<MainLayout title="Pool CPH">
  <main class="mb-s md:mb-l">
    <div class="flex flex-col gap-s md:gap-xl">
      <!-- ***************************** Start Hero ***************************** -->
      <section class="px-0 md:px-0 relative">
        <!-- Video mobil -->
        <video
          class="block md:hidden w-full h-[560px] object-cover relative z-0"
          src="/img/heromobilvideo.mov"
          autoplay
          muted
          loop
          playsinline
          webkit-playsinline
          preload="auto"></video>

        <!-- Video desktop -->
        <video
          class="hidden md:block w-full min-h-[600px] lg:max-h-[750px] h-auto object-cover relative z-0"
          src="/img/herovideo.mov"
          autoplay
          muted
          loop
          playsinline
          webkit-playsinline
          preload="auto"></video>

        <div
          class="absolute inset-0 flex items-center justify-center z-10 pointer-events-none"
        >
          <div class="pointer-events-auto mt-25 md:mt-35">
            <Bookingoverlay />
          </div>
        </div>
      </section>
      <!-- ***************************** End Hero ***************************** -->

      <!-- ***************************** Start Welcome ***************************** -->

      <section class="px-2xs md:px-xl whitespace-pre-line">
        <TextImgRight
          heading="Welcome"
          text={`Welcome to Pool Cph.

          More than just a pool bar. Right in the heart of Copenhagen, we've created a space where good energy, great drinks, and late nights come together. Pool tables, cold beers, cocktails, and salty snacks, all wrapped in a unique and laid-back atmosphere. Hang out inside or take it outside on our terrace. 
          
          It's casual. It's social. It's all about the vibe.
        `}
          image="/img/welcomeimage.webp"
          imageAlt="Welcome image"
        />
      </section>
      <!-- ***************************** End Welcome ***************************** -->

      <SectionDivider />

      <!-- ***************************** Start Prices ***************************** -->
      <section class="px-2xs md:px-xl">
        <TextImgLeft
          heading="Prices"
          text={`Whether you’re up for a quick game or a longer evening with friends, you can choose between 30, 60, 90 or 120 minutes.`}
          ctaLabel="Book pool table"
          buttonType="overlay"
          image="/img/tavlenvideo.gif"
          imageAlt="Price tavle"
        />
      </section>
      <!-- ***************************** End Prices ***************************** -->

      <SectionDivider />

      <!-- ***************************** Start Events ***************************** -->
      <section class="pl-2xs lg:px-xl flex flex-col">
        <Heading
          htmlheading="h2"
          size="medium"
          stylingclasses="mb-2xs text-text-dark">Events</Heading
        >

        <a
          href="/event"
          class="self-end inline-flex items-center gap-2 mb-4xs mr-2xs lg:mr-0"
        >
          <Text
            teksttype="brødtekst_bold"
            stylingclasses="text-text-dark hover:underline hover:underline-offset-2 hover:decoration-text-dark"
            >Alle events</Text
          >
          <img src="/img/piltilhøjre.svg" alt="Pil til højre" />
        </a>

        <div
          class="pr-2xs lg:pr-0 flex items-stretch gap-0 overflow-x-auto snap-x snap-mandatory lg:relative"
        >
          <div
            class="shrink-0 basis-6/8 snap-start lg:flex-1 lg:basis-0 lg:min-w-0"
          >
            <!-- TT - Tirdags tunering -->
            <EventCard
              class="w-full opacity-0 intersect:opacity-100 intersect:animate-fade-right intersect:animate-delay-100 intersect-once"
              smallVersion={true}
              noBorder={true}
              title="Tuesday’s Tournament"
              date="Every Tuesday / 20:00-22:00 / 50 kr."
              description="Join our weekly pool tournament. Every Tuesday at 20:00. Sign up with a teammate and play for fun, good vibes, and prizes! All levels are welcome."
              buttonText="Save Your Spot"
              overlayType="tt"
              imageSrc="/img/event1.webp"
              imageSrcMobile="/img/mobil-event1.webp"
              imageAlt="Tuesday’s Tournament"
            />
          </div>

          <div
            class="shrink-0 flex items-stretch justify-center pointer-events-none w-2xs lg:w-[var(--spacing-m)]"
          >
            <div
              class="h-full w-0 border-primary-line"
              style="border-right-width: var(--stroke-xs);"
            >
            </div>
          </div>

          <div
            class="shrink-0 basis-6/8 snap-start lg:flex-1 lg:basis-0 lg:min-w-0"
          >
            <!-- Summerparty -->
            <EventCard
              class="w-full opacity-0 intersect:opacity-100 intersect:animate-fade-right intersect:animate-delay-200 intersect-once"
              smallVersion={true}
              noBorder={true}
              title="Summerparty"
              date="19. June 2026 / 16:00-00:00 / Free entry"
              description="Join us at Pool Cph for a summer party with great vibes, cold drinks, and a DJ. Everybody is welcome. Bring your friends and celebrate summer with us."
              buttonText="See Facebook Event"
              buttonHref="https://www.facebook.com/poolcph"
              imageSrc="/img/event2.webp"
              imageSrcMobile="/img/mobil-event2.webp"
              imageAlt="Summerparty"
            />
          </div>

          <div
            class="shrink-0 flex items-stretch justify-center pointer-events-none w-2xs lg:w-[var(--spacing-m)]"
          >
            <div
              class="h-full w-0 border-primary-line"
              style="border-right-width: var(--stroke-xs);"
            >
            </div>
          </div>

          <div
            class="shrink-0 basis-6/8 snap-start lg:flex-1 lg:basis-0 lg:min-w-0"
          >
            <!-- Girls Night -->
            <EventCard
              class="w-full opacity-0 intersect:opacity-100 intersect:animate-fade-right intersect:animate-delay-300 intersect-once"
              smallVersion={true}
              noBorder={true}
              title="Girls Night"
              date="3. July 2026 / 20:00-00:00 / 100 kr."
              description="Join us at Pool Cph for a girls night filled with great vibes, cocktails, and good company. Grab your girls, dress up, and come enjoy a fun night out."
              buttonText="Save The Date"
              overlayProps={{
                submitButtonText: "Book nu",
                heading: "Join Our Girls Night",
                bodyText:
                  "Girls Night starts at 20:00. Spend the evening at Pool CPH with welcome drinks, light snacks including olives, nuts and chips, free access to the pool tables all night and great music in the perfect atmosphere. ",
                img1Src: "/img/overlay-girls-night1.webp",
                img1Alt: "Girls Night",
                img2Src: "/img/overlay-girls-night2.webp",
                img2Alt: "Girls Night",
              }}
              imageSrc="/img/event3.webp"
              imageSrcMobile="/img/mobil-event3.webp"
              imageAlt="Girls Night"
            />
          </div>
        </div>
      </section>
      <!-- ***************************** End Events ***************************** -->

      <SectionDivider />

      <!-- ***************************** Start Menu ***************************** -->
      <section class="px-2xs md:px-xl whitespace-pre-line">
        <TextImgLeft
          image="/img/gotomenu.mov"
          imageAlt="Go to menu image"
          imageClass="w-full h-auto md:h-auto object-cover"
          heading="Menu"
          text={`Take a look at what we have to offer. From classic cocktails to refreshing drinks and everything in between, our menu is made to match the vibe. Whether you're in the mood for something light or something bold, there's something for everyone. 
          
          Explore the full menu below.`}
          buttonType="link"
          href="/menu"
          ctaLabel="Go to menu"
        />
      </section>
      <!-- ***************************** End Menu ***************************** -->

      <SectionDivider />

      <!-- ***************************** Start Socials ***************************** -->
      <section>
        <Socials />
      </section>
      <!-- ***************************** End Socials ***************************** -->
    </div>
  </main>
</MainLayout>
