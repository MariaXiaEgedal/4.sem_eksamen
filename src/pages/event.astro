---
import MainLayout from "../layouts/MainLayout.astro";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import TextImgLeft from "../components/TextImgLeft.astro";
import EventCard from "../components/EventCard.astro";
import Faq from "../components/Faq.astro";
import SectionDivider from "../components/SectionDivider.astro";
---

<MainLayout title="Event">
  <main class="my-s md:my-l">
    <div class="flex flex-col gap-s md:gap-xl">
      <!-- ***************************** Start Event Intro ***************************** -->
      <section class="px-2xs md:px-xl">
        <div
          class="grid grid-cols-4 md:grid-cols-12 gap-2xs items-start md:items-center"
        >
          <div
            class="order-2 md:order-1 col-span-4 md:col-span-5 mt-2xs md:mt-0"
          >
            <img
              src="/img/eventbillede.webp"
              alt="Events image"
              class="w-full h-auto object-cover"
            />
          </div>

          <div
            class="order-1 md:order-2 col-span-4 md:col-span-6 md:col-start-7 text-text-dark"
          >
            <Heading
              htmlheading="h1"
              size="large"
              stylingclasses="leading-none"
            >
              Events
            </Heading>

            <Text teksttype="brødtekst" stylingclasses="mt-5xs md:mt-xs">
              Discover what's happening at Pool Cph. From themed nights and
              tournaments to special events and social gatherings, there's
              always something going on. Whether you're here for a casual night
              with friends or looking for a more lively atmosphere, our events
              are made to bring people together. Explore what's coming up and
              find your next night out.
            </Text>
          </div>
        </div>
      </section>
      <!-- ***************************** End Event Intro ***************************** -->

      <SectionDivider />

      <!-- ***************************** Start Events ***************************** -->
      <section class="px-2xs md:px-xl flex flex-col gap-2xs md:gap-2xs">
        <!-- TT - Tirdags tunering -->
        <EventCard
          class="relative z-[40]"
          title="Tuesday’s Tournament"
          date="Every Tuesday / 20:00-22:00 / 50 kr. per person"
          description="Join our weekly pool tournament. Every Tuesday at 20:00. Sign up with a teammate and play for fun (and nice prizes!) All levels are welcome."
          buttonText="Save Your Spot"
          overlayType="tt"
          imageSrc="/img/event1.webp"
          imageSrcMobile="/img/mobil-event1.webp"
          imageAlt="Tuesday’s Tournament"
        />
        <!-- Summerparty -->
        <EventCard
          class="relative z-[30] -translate-y-5 md:-translate-y-20 intersect-half intersect:translate-y-0 transition-transform duration-700 ease-out intersect-once"
          title="Summerparty"
          date="19. June 2026 / 16:00-00:00 / Free entry"
          description="Join us at Pool Cph for a summer party with great vibes, cold drinks, and a DJ all night. Everybody is welcome. Bring your friends and celebrate summer with us."
          buttonText="See Facebook Event"
          buttonHref="https://www.facebook.com/poolcph"
          imageSrc="/img/event2.webp"
          imageSrcMobile="/img/mobil-event2.webp"
          imageAlt="Summerparty"
        />
        <!-- Girls Night -->
        <EventCard
          class="relative z-[20] -translate-y-5 md:-translate-y-20 intersect-half intersect:translate-y-0 transition-transform duration-700 ease-out intersect-once"
          title="Girls Night"
          date="3. July 2026 / 20:00-00:00 / 100 kr per person"
          description="Join us at Pool Cph for a girls night filled with great vibes, cocktails, and good company. Grab your girls, dress up, and come enjoy a fun night out."
          buttonText="Save The Date"
          overlayProps={{
            submitButtonText: "Book nu",
            heading: "Join Our Girls Night",
            bodyText:
              "Girls Night starts at 20:00. Spend the evening at Pool CPH with welcome drinks, light snacks including olives, nuts and chips, free access to the pool tables all night and great music in the perfect atmosphere.",
            img1Src: "/img/overlay-girls-night1.webp",
            img1Alt: "Girls Night",
            img2Src: "/img/overlay-girls-night2.webp",
            img2Alt: "Girls Night",
          }}
          imageSrc="/img/event3.webp"
          imageSrcMobile="/img/mobil-event3.webp"
          imageAlt="Girls Night"
        />
        <!-- Dinner date -->
        <EventCard
          class="relative z-[10] -translate-y-5 md:-translate-y-20 intersect-half intersect:translate-y-0 transition-transform duration-700 ease-out intersect-once"
          title="Dinner date"
          date="7. July 2026 / 19:00-23:00 / 350 kr. per person"
          description="Join us at Pool Cph for an unforgettable dinner date with delicious food, great vibes, and even better company. Take a seat at our long table, enjoy a served dinner, and spend the evening socializing with friends, family, or meeting new people in a warm and welcoming atmosphere."
          buttonText="Save The Date"
          overlayProps={{
            submitButtonText: "Book nu",
            heading: "Join Our Dinner Date",
            bodyText:
              "Enjoy a cozy evening from 19:00–23:00 with delicious pasta dishes served with sides, tiramisu for dessert, and one glass of red wine included in the price. Additional drinks will be available for purchase throughout the evening.",
            img1Src: "/img/overlay-dinner-date1.webp",
            img1Alt: "Dinner date",
            img2Src: "/img/overlay-dinner-date2.webp",
            img2Alt: "Dinner date",
          }}
          imageSrc="/img/event4.webp"
          imageSrcMobile="/img/mobil-event4.webp"
          imageAlt="Dinner date"
        />
      </section>
      <!-- ***************************** End Events ***************************** -->

      <!-- <SectionDivider /> -->

      <!-- ***************************** Start Host Event ***************************** -->
      <section class="px-2xs md:px-xl whitespace-pre-line">
        <TextImgLeft
          heading="Looking to host an event?"
          text={`Whether it’s a Friday bar, birthday, company event or something entirely your own, Pool CPH offers the perfect setting. From small gatherings to larger events, the possibilities are endless, only your imagination sets the limits.

          If you have any questions or would like to make a booking, feel free to contact us.`}
          image="/img/hostevent.mov"
          imageClass="w-full h-[250px] md:h-[450px] object-cover"
          ctaLabel="Write us an email"
          buttonType="email"
        />
      </section>
      <!-- ***************************** End Host Event ***************************** -->

      <!-- ***************************** Start FAQ ***************************** -->
      <section class="px-2xs md:px-xl">
        <Faq />
      </section>
      <!-- ***************************** End FAQ ***************************** -->
    </div>
  </main>
</MainLayout>
