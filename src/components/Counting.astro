---
const {
  id = undefined,
  name = "people",
  min = 1,
  max = 12,
  value = 1,
} = Astro.props;

const uid = id || `counting-${Math.random().toString(36).slice(2, 9)}`;
let startValue = Number(value);
if (Number.isNaN(startValue)) startValue = min;
startValue = Math.min(Math.max(startValue, min), max);
---

<div
  id={uid}
  data-min={min}
  data-max={max}
  class="flex flex-col items-center text-text-light"
>
  <div class="flex items-center gap-4">
    <button
      type="button"
      aria-label="Decrease"
      data-action="decrement"
      class="text-3xl w-9 h-9 rounded-full border border-primary-beige flex items-center justify-center text-text-light"
      >−</button
    >

    <div class="text-xl font-medium text-light" aria-live="polite" data-value>
      {startValue}
    </div>

    <button
      type="button"
      aria-label="Increase"
      data-action="increment"
      class="text-3xl w-9 h-9 rounded-full border border-primary-beige flex items-center justify-center text-text-light"
      >+</button
    >
  </div>

  <input type="hidden" name={name} value={startValue} data-input />

  <div class="w-full mt-2 border-t border-primary-beige" aria-hidden="true">
  </div>
</div>

<script data-root-id={uid}>
  (function () {
    const script = document.currentScript;
    if (!script) return;
    const rootId =
      script.dataset && script.dataset.rootId ? script.dataset.rootId : null;
    const root = rootId
      ? document.getElementById(rootId)
      : script.previousElementSibling;
    if (!root) return;

    const MIN = Number(root.dataset.min) || 1;
    const MAX = Number(root.dataset.max) || 12;

    const btnDec = root.querySelector('[data-action="decrement"]');
    const btnInc = root.querySelector('[data-action="increment"]');
    const display = root.querySelector("[data-value]");
    const input = root.querySelector("[data-input]");

    let value = parseInt(input && input.value ? input.value : "", 10);
    if (isNaN(value)) value = MIN;
    value = Math.min(Math.max(value, MIN), MAX);

    function render() {
      if (display) display.textContent = String(value);
      if (input) input.value = String(value);
      if (btnDec) btnDec.disabled = value <= MIN;
      if (btnInc) btnInc.disabled = value >= MAX;
    }

    render();

    if (btnDec)
      btnDec.addEventListener("click", function () {
        value = Math.max(MIN, value - 1);
        render();
      });
    if (btnInc)
      btnInc.addEventListener("click", function () {
        value = Math.min(MAX, value + 1);
        render();
      });

    if (root instanceof HTMLElement) root.tabIndex = 0;
  })();
</script>
