---
import Button from "./Button.astro";
import Heading from "./Heading.astro";
import Text from "./Text.astro";
import Calendar from "./Calendar.astro";
import Counting from "./Counting.astro";

const { openButtonText = "Book pool table" } = Astro.props;
---

<div class="eventbooking-root">
  <!-- Page content -->
  <div>
    <Button class="eventbooking-open" variant="primary" size="medium"
      >{openButtonText}</Button
    >
  </div>

  <div class="eventbooking-portal">
    <!-- Overlay -->
    <div
      class="eventbooking-overlay fixed inset-0 z-[1000] bg-black/50 opacity-0 transition-opacity duration-500 ease-out pointer-events-none"
    >
    </div>

    <!-- Sidebar -->
    <div
      class="eventbooking-side bg-background-secondary fixed right-0 top-0 h-full w-full md:w-1/2 pt-s px-2xs md:px-m lg:px-l z-[1010] transform translate-x-full transition-transform duration-500 ease-in-out overflow-y-auto"
    >
      <!-- Topbar: centered logo with close button on same line -->
      <div class="relative mb-xs md:mb-s">
        <button
          class="eventbooking-close absolute right-0 top-0 text-3xl text-text-light"
          type="button">✕</button
        >
        <div class="flex justify-center">
          <img
            src="/img/logo-pool-hvid.svg"
            alt="Pool Logo"
            class="h-14 w-auto"
          />
        </div>
      </div>

      <!-- Calendar -->
      <div class="mb-xs md:mb-s">
        <Calendar />
      </div>

      <!-- Prices  -->
      <div class="mb-2xs md:mb-xs">
        <Heading
          htmlheading="h5"
          size="xsmallbold"
          stylingclasses="text-text-light mb-5xs">Prices: (30 min)</Heading
        >
        <Text teksttype="brødtekst-lille" stylingclasses="text-text-light">
          Monday - Wednesday: DKK 75 pr. 30 min <br /> Thursday - Saturday: DKK 100
          pr. 30 min
        </Text>
      </div>

      <!-- Table time -->
      <div class="mb-2xs md:mb-xs">
        <Heading
          htmlheading="h5"
          size="xsmallbold"
          stylingclasses="text-text-light mb-5xs">Table time</Heading
        >
        <Text
          teksttype="brødtekst"
          stylingclasses="text-text-light mb-4xs md:mb-2xs"
        >
          Choose how long you’d like to play
        </Text>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-[10px] md:gap-[20px]">
          <Button class="w-full" variant="outline_light" size="large"
            >30 min</Button
          >
          <Button class="w-full" variant="outline_light" size="large"
            >60 min</Button
          >
          <Button class="w-full" variant="outline_light" size="large"
            >90 min</Button
          >
          <Button class="w-full" variant="outline_light" size="large"
            >120 min</Button
          >
        </div>
      </div>

      <div
        class="grid grid-cols-1 lg:grid-cols-2 gap-0 lg:gap-2xs mb-2xs md:mb-xs"
      >
        <!-- Guests -->
        <div class="min-w-0 mb-2xs md:mb-xs">
          <Heading
            htmlheading="h5"
            size="xsmallbold"
            stylingclasses="text-text-light mb-5xs">Guests</Heading
          >
          <Text teksttype="brødtekst" stylingclasses="text-text-light mb-5xs">
            Select number of guests
          </Text>
          <Text
            teksttype="brødtekst-lille"
            stylingclasses="text-text-light mb-4xs md:mb-2xs"
          >
            (For more than 12 guests, please contact us)
          </Text>
          <div class="flex justify-start">
            <Counting />
          </div>
        </div>

        <!-- Time -->
        <div class="min-w-0">
          <Heading
            htmlheading="h5"
            size="xsmallbold"
            stylingclasses="text-text-light mb-5xs">Time</Heading
          >
          <Text
            teksttype="brødtekst"
            stylingclasses="text-text-light mb-2xs md:mb-xs"
          >
            Available times:
          </Text>
          <div class="grid grid-cols-3 gap-[10px] md:gap-[20px]">
            <Button class="w-full" variant="outline_light" size="small"
              >16:00</Button
            >
            <Button class="w-full" variant="outline_light" size="small"
              >16:30</Button
            >
            <Button class="w-full" variant="outline_light" size="small"
              >17:00</Button
            >
            <Button class="w-full" variant="outline_light" size="small"
              >17:30</Button
            >
            <Button class="w-full" variant="outline_light" size="small"
              >18:00</Button
            >
            <Button class="w-full" variant="outline_light" size="small"
              >18:30</Button
            >
            <Button class="w-full" variant="outline_light" size="small"
              >19:00</Button
            >
            <Button class="w-full" variant="outline_light" size="small"
              >19:30</Button
            >
            <Button class="w-full" variant="outline_light" size="small"
              >20:00</Button
            >
          </div>
        </div>
      </div>

      <!-- Continue Booking Button -->
      <div>
        <Button class="w-full gap-2" variant="secondary" size="mediumOverlay">
          <span>Continue Booking</span>
          <img src="/img/piltilhøjre.svg" alt="" aria-hidden="true" />
        </Button>
      </div>
    </div>
  </div>
</div>

<script>
  const p = document.querySelector(".eventbooking-portal"),
    o = p?.querySelector(".eventbooking-overlay"),
    d = p?.querySelector(".eventbooking-side");
  document.body.appendChild(p);
  const t = (n) => {
    o?.classList.toggle("opacity-100", n);
    o?.classList.toggle("pointer-events-none", !n);
    d?.classList.toggle("translate-x-0", n);
    d?.classList.toggle("translate-x-full", !n);
    document.documentElement.classList.toggle("overflow-hidden", n);
  };
  document
    .querySelector(".eventbooking-open")
    ?.addEventListener("click", () => t(1));
  p?.querySelector(".eventbooking-close")?.addEventListener("click", () =>
    t(0),
  );
  o?.addEventListener("click", () => t(0));
</script>
