---
import Heading from "./Heading.astro";
import Text from "./Text.astro";
import Button from "./Button.astro";
import EventBookingOverlay from "./EventBookingOverlay.astro";
import TTOverlay from "./TT-Overlay.astro";

const {
  title = "Event overskrift",
  date = "Dato / tid / pris for eventet",
  description = "Info om eventet: lorem ipsum dolor sit amet consectetur adipisicing elit. Obcaecati neque quam animi nihil sequi officiis inventore nisi odit maiores? Quibusdam excepturi laboriosam!",
  buttonText = "Knap for deltagelse",
  buttonHref = null,
  imageSrc = "/img/event.png",
  imageSrcMobile = "/img/mobil-event.png",
  imageAlt = "Event billede",
  smallVersion = false,
  noBorder = false,
  overlayType = null,
  overlayProps = null,
  class: className = "",
} = Astro.props;

const shouldRenderOverlay = overlayType !== null || overlayProps !== null;
const OverlayComponent = overlayType === "tt" ? TTOverlay : EventBookingOverlay;
const resolvedOverlayProps = {
  openButtonText: buttonText,
  ...(overlayProps || {}),
};
const isExternalButtonHref = typeof buttonHref === "string" && /^https?:\/\//.test(buttonHref);
---

<div
  class={`grid grid-cols-4 ${smallVersion ? "" : "md:grid-cols-12"} gap-2xs ${noBorder ? "" : "border-b border-primary-line"} ${className}`}
  style={noBorder ? undefined : "border-bottom-width: var(--stroke-xs);"}
>
  <div
    class={`col-span-4 flex flex-col justify-center order-2 ${smallVersion ? "" : "md:col-start-1 md:col-span-5 md:order-1"}`}
  >
    <Heading
      htmlheading="h3"
      size="small"
      stylingclasses="mb:2xs mb-4xs md:mb-xs text-text-dark">{title}</Heading
    >
    <Text teksttype="brødtekst_bold" stylingclasses="mb-2xs text-text-dark"
      >{date}</Text
    >
    <Text teksttype="brødtekst" stylingclasses="mb-2xs md:mb-xs text-text-dark"
      >{description}</Text
    >
    <div class="self-start mb-2xs">
      {
        shouldRenderOverlay ? (
          <OverlayComponent {...resolvedOverlayProps} />
        ) : buttonHref ? (
          <a
            href={buttonHref}
            target={isExternalButtonHref ? "_blank" : undefined}
            rel={isExternalButtonHref ? "noopener noreferrer" : undefined}
            class="inline-block bg-cta-primary text-text-light px-xs py-4xs hover:px-m hover:shadow-lg rounded-xs transition-all duration-300 ease-out text-[16px] md:text-[22px]"
          >
            {buttonText}
          </a>
        ) : (
          <Button variant="primary" size="medium">
            {buttonText}
          </Button>
        )
      }
    </div>
  </div>

  <div
    class={`col-span-4 flex items-end order-1 ${smallVersion ? "" : "md:col-start-7 md:col-end-13 md:order-2"}`}
  >
    <div class="w-full">
      <div class="">
        <img
          src={imageSrcMobile || imageSrc}
          alt={imageAlt}
          class={`w-full ${smallVersion ? "" : "md:hidden"}`}
        />
        <img
          src={imageSrc}
          alt={imageAlt}
          class={`w-full hidden ${smallVersion ? "" : "md:block"}`}
        />
      </div>
    </div>
  </div>
</div>
