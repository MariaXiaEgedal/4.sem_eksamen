---
import Heading from "./Heading.astro";
import Text from "./Text.astro";

const {
  heading = "Overskrift",
  text = "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. ",
  image = "/img/welcomeimage.webp",
  imageAlt = "",
  logo = "/img/logo-pool-rod.svg",
  logoAlt = "Pool Cph logo",
  showLogo = true,
} = Astro.props;

const isVideo = /\.(mov)$/i.test(image);
---

<div
  class="grid grid-cols-4 md:grid-cols-12 gap-2xs items-start md:items-center"
>
  <div class="col-start-1 col-end-5 md:col-end-7 text-text-dark">
    <Heading htmlheading="h1" size="large">{heading}</Heading>
    <Text teksttype="brødtekst" stylingclasses="mt-5xs max-w-[38rem]">
      {text}
    </Text>

    {showLogo && <img src={logo} alt={logoAlt} class="mt-2xs h-8" />}
  </div>

  <div class="col-span-4 md:col-span-5 md:col-start-8 flex justify-end">
    {
      isVideo ? (
        <video
          src={image}
          class="w-full h-auto"
          playsinline
          autoplay
          muted
          loop
          preload="metadata"
        />
      ) : (
        <img src={image} alt={imageAlt} class="w-full h-auto" />
      )
    }
  </div>
</div>
