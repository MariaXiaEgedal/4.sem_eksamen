---
import Heading from "./Heading.astro";
import Text from "./Text.astro";
import Button from "./Button.astro";

const {
  title = "Event overskrift",
  date = "Dato / tid / pris for eventet",
  description = "Info om eventet: lorem ipsum dolor sit amet consectetur adipisicing elit. Obcaecati neque quam animi nihil sequi officiis inventore nisi odit maiores? Quibusdam excepturi laboriosam!",
  buttonText = "Knap for deltagelse",
  imageSrc = "/img/event.png",
  imageSrcMobile = "/img/mobil-event.png",
  imageAlt = "Event billede",
} = Astro.props;
---

<div
  class="grid grid-cols-4 md:grid-cols-12 gap-2xs border-primary-line"
  style="border-bottom-width: var(--stroke-xs);"
>
  <div
    class="col-span-4 md:col-start-1 md:col-span-5 flex flex-col justify-center order-2 md:order-1"
  >
    <Heading
      htmlheading="h3"
      size="small"
      stylingclasses="mb:2xs mb-4xs md:mb-xs text-text-dark">{title}</Heading
    >
    <Text teksttype="brødtekst_bold" stylingclasses="mb-2xs text-text-dark"
      >{date}</Text
    >
    <Text teksttype="brødtekst" stylingclasses="mb-2xs md:mb-xs text-text-dark"
      >{description}</Text
    >
    <div class="self-start mb-2xs">
      <Button variant="primary" size="medium">{buttonText}</Button>
    </div>
  </div>

  <div
    class="col-span-4 md:col-start-7 md:col-end-13 flex items-end order-1 md:order-2"
  >
    <div class="w-full">
      <div class="">
        <img
          src={imageSrcMobile || imageSrc}
          alt={imageAlt}
          class="w-full md:hidden"
        />
        <img src={imageSrc} alt={imageAlt} class="w-full hidden md:block" />
      </div>
    </div>
  </div>
</div>
