---
import Text from "./Text.astro";
const { id = undefined, name = "people", value = 1 } = Astro.props;

const MIN = 1;
const MAX = 12;
const uid = id || `counting-${Math.random().toString(36).slice(2, 9)}`;
let startValue = Math.min(MAX, Math.max(MIN, Number(value) || MIN));
---

<div id={uid} class="flex flex-col items-center text-text-light">
  <div class="flex items-center gap-4">
    <button
      type="button"
      aria-label="Decrease"
      data-action="decrement"
      class="text-3xl w-9 h-9 rounded-full border border-primary-beige flex items-center justify-center text-text-light"
      ><span class="leading-none align-middle relative -top-px">−</span></button
    >

    <Text teksttype="brødtekst" stylingclasses="">
      <span aria-live="polite" data-value>{startValue}</span>
    </Text>

    <button
      type="button"
      aria-label="Increase"
      data-action="increment"
      class="text-3xl w-9 h-9 rounded-full border border-primary-beige flex items-center justify-center text-text-light"
      ><span class="leading-none align-middle relative -top-px">+</span></button
    >
  </div>

  <input type="hidden" name={name} value={startValue} data-input />

  <div
    class="mt-2 border-t border-primary-beige"
    style="width: 120px; display: block;"
    aria-hidden="true"
  >
  </div>
</div>

<script define:vars={{ uid, MIN, MAX }}>
  const root = document.getElementById(uid);
  if (!root) return;

  const buttonDown = root.querySelector('[data-action="decrement"]');
  const buttonUp = root.querySelector('[data-action="increment"]');
  const display = root.querySelector("[data-value]");
  const input = root.querySelector("[data-input]");

  let value = Math.min(MAX, Math.max(MIN, Number(input.value) || MIN));

  const setValue = (next) => {
    value = Math.min(MAX, Math.max(MIN, next));
    display.textContent = input.value = String(value);
    // make buttons invisible at boundaries (keep layout), and prevent interaction
    if (value === MIN) buttonDown.classList.add("invisible");
    else buttonDown.classList.remove("invisible");
    buttonDown.disabled = value === MIN;
    buttonDown.setAttribute("aria-hidden", value === MIN ? "true" : "false");

    if (value === MAX) buttonUp.classList.add("invisible");
    else buttonUp.classList.remove("invisible");
    buttonUp.disabled = value === MAX;
    buttonUp.setAttribute("aria-hidden", value === MAX ? "true" : "false");
  };

  buttonDown.addEventListener("click", () => setValue(value - 1));
  buttonUp.addEventListener("click", () => setValue(value + 1));
  setValue(value);
</script>
