---

<MainLayout title="Menu">
  <main class="my-s md:my-l">
    <div class="flex flex-col gap-s md:gap-l">
      <section class="px-2xs md:px-xl">
        <TextImgRight
          heading="Menu"
          text={`Explore the menu at Pool CPH with everything from cold beers and cocktails to wine and salty snacks, perfect for a night of pool and good vibes.`}
          logo=""
          logoAlt=""
          image="img/menu.gif"
          imageAlt="Menu image"
        />
      </section>

      <section class="px-2xs md:px-xl">
        <MenuCard
          title="Cocktails"
          items={cocktails}
          imageSrc="/img/menu-cocktails.png"
          imageAlt="Cocktail-udvalg"
          isOpen={false}
        />
        <MenuCard
          title="Wine"
          items={wines}
          imageSrc="/img/menu-wine.png"
          imageAlt="Wine selection"
          isOpen={false}
        />
        <MenuCard
          title="Beer, longdrinks & Other"
          items={beers}
          imageSrc="/img/menu-beer.png"
          imageAlt="Beer selection"
          isOpen={false}
        />
        <MenuCard
          title="Alcohol free"
          items={alcoholFree}
          imageSrc="/img/menu-alcohol-free.png"
          imageAlt="Alcohol free selection"
          isOpen={false}
        />
        <MenuCard
          title="Snacks"
          items={snacks}
          imageSrc="/img/menu-snacks.png"
          imageAlt="Snacks selection"
          isOpen={false}
        />
      </section>
    </div>
  </main>
</MainLayout>
