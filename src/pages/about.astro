---
import MainLayout from "../layouts/MainLayout.astro";
import Link from "../components/Link.astro";
import { Image } from "astro:assets";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import Button from "../components/Button.astro";
import TextImgRight from "../components/TextImgRight.astro";
import TimeLine from "../components/TimeLine.astro";
import Faq from "../components/Faq.astro";
import TextImgLeft from "../components/TextImgLeft.astro";
import Socials from "../components/Socials.astro";
---

<MainLayout title="About us">
  <!-- Denne linje under betyder gappet mellem sektioner 40px/mobil og 80px/desktop (Jeg har lavet den)-->
  <!-- flex flex-col gap-s md:gap-l  -->

  <!-- Denne linje under betyder padding på x-aksen 20px/mobil og 100px/desktop (Jeg har lavet den) -->
  <!-- px-2xs md:px-xl -->

  <!-- Denne linje under betyder grid til mobil (4 kolonner) og desktop (12 kolonner) og begge med 20px mellemrum (den skal i bruge hvis designet følger vores grid) -->
  <!-- grid grid-cols-4 md:grid-cols-12 gap-2xs -->
  <main class="my-s md:my-l">
    <div class="flex flex-col gap-s md:gap-l">
      <section class="bg-red-500 px-2xs md:px-xl">
        <p>About us</p>
        <TextImgRight />
      </section>

      <section class="bg-orange-500 px-2xs md:px-xl">
        <p>The history of pool</p>
        <Heading htmlheading="h2" size="medium" stylingclasses="text-text-dark"
          >The history of pool</Heading
        >
        <TimeLine />
      </section>

      <section class="bg-yellow-500 px-2xs md:px-xl">
        <p>A New Way to Socialize</p>
        <Heading htmlheading="h2" size="medium" stylingclasses="text-text-dark"
          >A New Way to Socialize</Heading
        >
      </section>

      <section class="bg-green-500 px-2xs md:px-xl">
        <p>FAQ</p>
        <Faq />
      </section>

      <section class="bg-blue-500 px-2xs md:px-xl">
        <p>Location</p>
        <TextImgLeft />
      </section>

      <section class="bg-purple-500">
        <p>Socials</p>
        <Heading
          htmlheading="h2"
          size="medium"
          stylingclasses="text-text-dark px-2xs md:px-xl">Socials</Heading
        >
        <Socials />
      </section>
    </div>
  </main>
</MainLayout>
