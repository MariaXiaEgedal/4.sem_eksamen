---
import Button from "./Button.astro";
import Bookingoverlay from "./Bookingoverlay.astro";
import Text from "./Text.astro";
import Heading from "./Heading.astro";

const {
  image = "/img/welcomeimage.webp",
  imageAlt = "",
  heading = "Overskrift",
  text = "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
  ctaLabel = "CTA primary",
  buttonType = null,
  href = null,
  ctaHref = null,
  ctaOnClickHref = null,
  mapSrc = null,
  mapTitle = "Location map",
  imageClass = "w-full h-auto object-cover",
} = Astro.props;

const isVideo = /\.(mov)$/i.test(image);

const resolvedButtonType =
  buttonType ||
  (ctaOnClickHref
    ? "link"
    : ctaHref === "mailto:info@poolcph.dk"
      ? "email"
      : ctaHref
        ? "link"
        : "button");
const resolvedHref = href || ctaOnClickHref || ctaHref || "";
const buttonLinkClasses =
  "rounded-xs transition-all duration-300 ease-out inline-flex items-center justify-center bg-cta-primary text-text-light px-xs py-4xs hover:px-m hover:shadow-lg text-[16px] md:text-[22px]";
---

<div
  class="grid grid-cols-4 md:grid-cols-12 gap-2xs items-start md:items-center"
>
  <div class="col-span-4 md:col-span-5">
    {
      mapSrc ? (
        <iframe
          src={mapSrc}
          title={mapTitle}
          class="w-full h-[280px] md:h-[360px] "
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        />
      ) : isVideo ? (
        <video
          src={image}
          class={imageClass}
          playsinline
          autoplay
          muted
          loop
          preload="metadata"
        />
      ) : (
        <img src={image} alt={imageAlt} class={imageClass} />
      )
    }
  </div>

  <div class="col-span-4 md:col-span-6 md:col-start-7 text-text-dark">
    <Heading size="medium" stylingclasses="leading-none">
      {heading}
    </Heading>

    <Text teksttype="brødtekst" stylingclasses="mt-2xs">
      {text}
    </Text>

    <div class="mt-2xs md:mt-xs">
      {
        resolvedButtonType === "overlay" ? (
          <Bookingoverlay openButtonText={ctaLabel} />
        ) : ctaLabel ? (
          resolvedButtonType === "email" ? (
            <a href="mailto:info@poolcph.dk" class={buttonLinkClasses}>
              {ctaLabel}
            </a>
          ) : resolvedButtonType === "link" ? (
            <a href={resolvedHref} class={buttonLinkClasses}>
              {ctaLabel}
            </a>
          ) : (
            <Button variant="primary" size="medium">
              {ctaLabel}
            </Button>
          )
        ) : null
      }
    </div>
  </div>
</div>
