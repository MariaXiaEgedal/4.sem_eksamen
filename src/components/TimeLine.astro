<script>
  import { animate, inView } from "motion";

  inView(".timelineelementerinview", () => {
    animate(
      ".timelineelementer1",
      { x: [-2000, 0], y: [-50, 0] },
      { duration: 1 },
    );
    animate(
      ".timelineelementer2",
      { x: [-1500, 0], y: [-100, 0] },
      { duration: 3 },
    );
    animate(
      ".timelineelementer3",
      { x: [-1000, 0], y: [-150, 0] },
      { duration: 3 },
    );
    animate(".timelineelementer4", { x: [1750, 0] }, { duration: 2 });
    animate(
      ".timelineelementer5",
      { x: [-2000, 0], y: [-100, 0] },
      { duration: 1 },
    );
    animate(".timelineelementer6", { x: [2000, 0] }, { duration: 2 });
    animate(
      ".timelineelementer7",
      { x: [1500, 0], y: [50, 0] },
      { duration: 3 },
    );
    animate(
      ".timelineelementer8",
      { x: [1000, 0], y: [150, 0] },
      { duration: 2 },
    );
    animate(
      ".timelineelementer9",
      { x: [1500, 0], y: [0, 0] },
      { duration: 1 },
    );
    animate(
      ".timelineelementer10",
      { x: [2000, 0], y: [50, 0] },
      { duration: 2 },
    );
  });
</script>
