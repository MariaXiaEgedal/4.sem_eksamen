---
import Heading from "./Heading.astro";
import Text from "./Text.astro";

const images = [
  "/img/some1.webp",
  "/img/some2.webp",
  "/img/some3.webp",
  "/img/some4.webp",
  "/img/some5.webp",
  "/img/some6.webp",
];
const duplicatedImages = [...images, ...images];
---

<section class="text-text-dark overflow-hidden pb-s">
  <div class="mx-2xs md:mx-xl">
    <Heading htmlheading="h2" size="medium" stylingclasses="mb-4xs md:mb-xs">
      Follow us on instagram
    </Heading>

    <a
      href="https://www.instagram.com/poolcph/"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block mb-s"
    >
      <Text teksttype="brødtekst">@poolcph</Text>
    </a>
  </div>

  <div class="social-carousel overflow-hidden">
    <div class="social-track flex gap-2xs">
      {
        duplicatedImages.map((image) => (
          <a
            href="https://www.instagram.com/pool_cph/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Open Pool CPH on Instagram"
            class="group/item social-item relative block w-[220px] md:w-[260px] shrink-0 overflow-hidden rounded-xs"
          >
            <img
              src={image}
              alt="Pool CPH Instagram image"
              class="w-[220px] md:w-[260px] shrink-0"
              loading="lazy"
            />
            <span class="absolute inset-0 flex items-center justify-center opacity-0 transition-opacity group-hover/item:opacity-100">
              <img
                src="/img/icon-instagram-hvid.svg"
                alt=""
                aria-hidden="true"
                class="h-10 w-10"
              />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .social-carousel:hover .social-track {
    animation-play-state: paused;
  }

  .social-track {
    animation: scroll 15s linear infinite;
  }

  @keyframes scroll {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }
</style>
