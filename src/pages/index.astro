---
import MainLayout from "../layouts/MainLayout.astro";
import Link from "../components/Link.astro";
import { Image } from "astro:assets";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import Button from "../components/Button.astro";
import TextImgLeft from "../components/TextImgLeft.astro";
import TextImgRight from "../components/TextImgRight.astro";
import EventCard from "../components/EventCard.astro";
import Socials from "../components/Socials.astro";
import SectionDivider from "../components/SectionDivider.astro";
import EventBookingOverlay from "../components/EventBookingOverlay.astro";
---

<MainLayout title="Pool CPH">
  <!-- Denne linje under betyder gappet mellem sektioner 40px/mobil og 80px/desktop (Jeg har lavet den)-->
  <!-- flex flex-col gap-s md:gap-l  -->

  <!-- Denne linje under betyder padding på x-aksen 20px/mobil og 100px/desktop (Jeg har lavet den) -->
  <!-- px-2xs md:px-xl -->

  <!-- Denne linje under betyder grid til mobil (4 kolonner) og desktop (12 kolonner) og begge med 20px mellemrum (den skal i bruge hvis designet følger vores grid) -->
  <!-- grid grid-cols-4 md:grid-cols-12 gap-2xs -->
  <main class="mb-s md:mb-l">
    <div class="flex flex-col gap-s md:gap-l">
      <!-- ***************************** Start Hero ***************************** -->
      <section class="px-0 md:px-0 relative">
        <video
          class="block md:hidden w-full min-h-[550px] h-auto object-cover relative z-0"
          src="/img/heromobilvideo.mov"
          autoplay
          muted
          loop
          playsinline></video>

        <video
          class="hidden md:block w-full min-h-[600px] lg:max-h-[750px] h-auto object-cover relative z-0"
          src="/img/herovideo.mov"
          autoplay
          muted
          loop
          playsinline></video>

        <div
          class="absolute inset-0 flex items-center justify-center z-10 pointer-events-none"
        >
          <div class="pointer-events-auto mt-25 md:mt-35">
            <Button variant="primary" size="medium">Book pool table</Button>
          </div>
        </div>
      </section>
      <!-- ***************************** End Hero ***************************** -->

      <!-- ***************************** Start Welcome ***************************** -->

      <section class="px-2xs md:px-xl whitespace-pre-line">
        <TextImgRight
          heading="Welcome"
          text={`Welcome to Pool Cph.

          More than just a pool bar. Right in the heart of Copenhagen, we've created a space where good energy, great drinks, and late nights come together. Pool tables, cold beers, cocktails, and salty snacks, all wrapped in a unique and laid-back atmosphere. Hang out inside or take it outside on our terrace. 
          
          It's casual. It's social. It's all about the vibe.
        `}
          image="/img/welcomeimage.jpg"
          imageAlt="Welcome image"
        />
      </section>
      <!-- ***************************** End Welcome ***************************** -->

      <!-- Indsæt overlay komponenetet her IKKE DONE!-->
      <section class="px-2xs md:px-xl">
        <EventBookingOverlay
          openButtonText="TEST Book event"
          submitButtonText="Book nu"
          heading="Book dit event"
          bodyText={`Her kan du booke et event hos os. Udfyld oplysningerne, så vender vi tilbage med bekræftelse.`}
          img1Src="/img/hey.jpg"
          img1Alt="Event billede 1"
          img2Src="/img/hey.jpg"
          img2Alt="Event billede 2"
        />
        <EventBookingOverlay
          openButtonText="TEST Book event"
          submitButtonText="Book nu"
          heading="Book dit event"
          bodyText={`Her kan du booke et event hos os. Udfyld oplysningerne, så vender vi tilbage med bekræftelse.`}
          img1Src="/img/hey.jpg"
          img1Alt="Event billede 1"
          img2Src="/img/hey.jpg"
          img2Alt="Event billede 2"
        />
      </section>

      <SectionDivider />

      <!-- ***************************** Start Prices ***************************** -->
      <section class="px-2xs md:px-xl">
        <TextImgLeft
          heading="Prices"
          text={`Whether you’re up for a quick game or a longer evening with friends, you can choose between 30, 60, 90 or 120 minutes.`}
          ctaLabel="Book pool table"
          image="/img/tavlenvideo.gif"
          imageAlt="Price tavle"
        />
      </section>
      <!-- ***************************** End Prices ***************************** -->

      <SectionDivider />

      <!-- ***************************** Start Events ***************************** -->
      <section
        class="bg-green-500 pl-2xs lg:px-xl flex flex-col gap-2xs lg:gap-0"
      >
        <Heading
          htmlheading="h2"
          size="medium"
          stylingclasses="mb-2xs text-text-dark">Events</Heading
        >

        <!-- Mangler linje under og pil -->
        <a href="/event" class="self-end">
          <Text
            teksttype="brødtekst_bold"
            stylingclasses="mb-2xs text-text-dark">Alle events</Text
          >
        </a>

        <div
          class="pr-2xs lg:pr-0 flex items-start gap-2xs overflow-x-auto snap-x snap-mandatory lg:grid lg:grid-cols-6 lg:gap-m :overflow-visible"
        >
          <EventCard
            class="shrink-0 basis-6/8 snap-start md:col-span-2"
            smallVersion={true}
            noBorder={true}
            title="Tuesday’s Tournament"
            date="Every Tuesday / 20:00-22:00 / 50 kr. per person"
            description="Join our weekly pool tournament. Every Tuesday at 20:00. Sign up with a teammate and play for fun (and nice prizes!) All levels are welcome."
            buttonText="Save Your Spot"
            imageSrc="/img/event1.png"
            imageSrcMobile="/img/mobil-event1.png"
            imageAlt="Tuesday’s Tournament"
          />
          <EventCard
            class="shrink-0 basis-6/8 snap-start md:col-span-2"
            smallVersion={true}
            noBorder={true}
            title="Summerparty"
            date="19. June 2026 / 16:00-00:00 / Free entry"
            description="Join us at Pool Cph for a summer party with great vibes, cold drinks, and a DJ all night. Everybody is welcome. Bring your friends and celebrate summer with us."
            buttonText="See Facebook Event"
            imageSrc="/img/event2.png"
            imageSrcMobile="/img/mobil-event2.png"
            imageAlt="Summerparty"
          />
          <EventCard
            class="shrink-0 basis-6/8 snap-start md:col-span-2"
            smallVersion={true}
            noBorder={true}
            title="Girls Night"
            date="3. July 2026 / 20:00-00:00 / 100 kr per person"
            description="Join us at Pool Cph for a girls night filled with great vibes, cocktails, and good company. Grab your girls, dress up, and come enjoy a fun night out."
            buttonText="Save The Date"
            imageSrc="/img/event3.png"
            imageSrcMobile="/img/mobil-event3.png"
            imageAlt="Girls Night"
          />
        </div>
      </section>
      <!-- ***************************** End Events ***************************** -->

      <SectionDivider />

      <!-- ***************************** Start Menu ***************************** -->
      <section class="bg-blue-500 px-2xs md:px-xl whitespace-pre-line">
        <TextImgLeft
          image="/img/gotomenu.mov"
          imageAlt="Go to menu image"
          imageClass="w-full h-[360px] md:h-[600px] object-cover"
          heading="Menu"
          text={`Take a look at what we have to offer. From classic cocktails to refreshing drinks and everything in between, our menu is made to match the vibe. Whether you're in the mood for something light or something bold, there's something for everyone. 
          
          Explore the full menu below.`}
          ctaOnClickHref="/menu"
          ctaLabel="Go to menu"
        />
      </section>
      <!-- ***************************** End Menu ***************************** -->

      <SectionDivider />

      <!-- ***************************** Start Socials ***************************** -->
      <section>
        <Socials />
      </section>
      <!-- ***************************** End Socials ***************************** -->
    </div>
  </main>
</MainLayout>
