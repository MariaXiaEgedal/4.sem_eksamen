---
const {
  htmlheading = "h2",
  size = "medium",
  stylingclasses = "",
} = Astro.props;
const Htmlheading = htmlheading;

const sizeClasses = {
  large:
    "text-[60px] md:text-[110px] leading-[1.1] opacity-0 intersect:opacity-100 intersect:animate-fade-right intersect-once",
  medium:
    "text-[40px] md:text-[70px] leading-[1.1] opacity-0 intersect:opacity-100 intersect:animate-fade-right intersect-once",
  small: "text-[30px] md:text-[45px] leading-[1.1] ",
  xsmall: "text-[25px] md:text-[40px] ",
  xsmallbold: "text-[20px] md:text-[30px] ",
};

const fontClasses = {
  h1: "font-display font-normal",
  h2: "font-serif font-semibold",
  h3: "font-serif font-semibold",
  h4: "font-serif font-semibold",
  h5: "font-serif font-bold",
};

const fontClass = fontClasses[(Htmlheading || "").toLowerCase()] ?? "";
---

<Htmlheading class:list={[stylingclasses, sizeClasses[size], fontClass]}>
  <slot />
</Htmlheading>
