---
import Button from "./Button.astro";
import Heading from "./Heading.astro";
import Text from "./Text.astro";

const {
  openButtonText = "Book pool table",
  submitButtonText = "Complete booking",
  heading = "Overskrift",
  bodyText = `Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod
tempor incididunt ut labore et dolore magna aliqua. Lorem ipsum dolor sit
amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt`,
  img1Src = "/img/hey.jpg",
  img1Alt = "Event Image 1",
  img2Src = "/img/hey.jpg",
  img2Alt = "Event Image 2",
} = Astro.props;
---

<div>
  <!-- Page content -->
  <div>
    <Button id="open-booking-overlay" variant="primary" size="medium">
      {openButtonText}
    </Button>
  </div>

  <!-- Overlay -->
  <div
    id="booking-overlay"
    class="fixed inset-0 z-[60] bg-black/50 opacity-0 transition-opacity duration-500 ease-out pointer-events-none"
  >
  </div>

  <!-- Sidebar -->
  <div
    id="booking-drawer"
    class="bg-background-primary fixed right-0 top-0 h-full md:w-1/2 pt-s px-2xs md:px-m lg:px-l z-[70] transform translate-x-full transition-transform duration-500 ease-in-out overflow-y-auto"
  >
    <!-- Topbar: centered logo with close button on same line -->
    <div class="relative mb-xs md:mb-s">
      <button
        id="close-booking-overlay"
        class="absolute right-0 top-0 text-3xl text-text-dark"
      >
        ✕
      </button>
      <div class="flex justify-center">
        <img src="/img/logo-pool-rod.svg" alt="Pool Logo" class="h-14 w-auto" />
      </div>
    </div>

    <!-- Title -->
    <Heading
      htmlheading="h4"
      size="xsmall"
      stylingclasses="text-text-dark mb-4xs"
    >
      {heading}
    </Heading>

    <!-- Description -->
    <Text teksttype="brødtekst" stylingclasses="text-text-dark mb-xs md:mb-s">
      {bodyText}
    </Text>

    <!-- Form -->
    <form class="space-y-3xs md:space-y-2xs mb-xs md:mb-s">
      <!-- Name and Last Name Row -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-2xs">
        <div>
          <label>
            <Text
              teksttype="brødtekst_lille"
              stylingclasses="text-text-dark mb-5xs"
            >
              Name <span class="text-text-dark">*</span>
            </Text>
          </label>
          <input
            type="text"
            placeholder=""
            class="w-full bg-transparent text-text-dark border-b-2 border-primary-line focus:border-primary-line py-5xs"
            required
          />
        </div>
        <div>
          <label>
            <Text
              teksttype="brødtekst_lille"
              stylingclasses="text-text-dark mb-5xs"
            >
              Last name <span class="text-text-dark">*</span>
            </Text>
          </label>
          <input
            type="text"
            placeholder=""
            class="w-full bg-transparent text-text-dark border-b-2 border-primary-line focus:border-primary-line py-5xs"
            required
          />
        </div>
      </div>

      <!-- Email -->
      <div>
        <label>
          <Text
            teksttype="brødtekst_lille"
            stylingclasses="text-text-dark mb-5xs"
          >
            Email <span class="text-text-dark">*</span>
          </Text>
        </label>
        <input
          type="email"
          placeholder=""
          class="w-full bg-transparent text-text-dark border-b-2 border-primary-line focus:border-primary-line py-5xs"
          required
        />
      </div>

      <!-- Phone Number -->
      <div>
        <label class="block">
          <Text
            teksttype="brødtekst_lille"
            stylingclasses="text-text-dark mb-5xs"
          >
            Phone number <span class="text-text-dark">*</span>
          </Text>
        </label>
        <input
          type="tel"
          placeholder=""
          class="w-full bg-transparent text-text-dark border-b-2 border-primary-line focus:border-primary-line py-5xs"
          required
        />
      </div>

      <!-- Submit Button -->
      <div class="booking-submit w-full mt-xs md:mt-s">
        <Button variant="primary" size="medium">{submitButtonText}</Button>
      </div>
    </form>

    <!-- Images Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-2xs">
      <img src={img1Src} alt={img1Alt} class="w-full h-full object-cover" />
      <img
        src={img2Src}
        alt={img2Alt}
        class="hidden md:block w-full h-full object-cover"
      />
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const openBtn = document.getElementById("open-booking-overlay");
    const closeBtn = document.getElementById("close-booking-overlay");
    const overlay = document.getElementById("booking-overlay");
    const drawer = document.getElementById("booking-drawer");

    const openDrawer = () => {
      if (overlay) {
        overlay.classList.remove("pointer-events-none", "opacity-0");
        overlay.classList.add("opacity-100");
      }
      if (drawer) {
        drawer.classList.remove("translate-x-full");
        drawer.classList.add("translate-x-0");
      }
      document.documentElement.classList.add("overflow-hidden");
    };

    const closeDrawer = () => {
      if (overlay) {
        overlay.classList.remove("opacity-100");
        overlay.classList.add("opacity-0", "pointer-events-none");
      }
      if (drawer) {
        drawer.classList.remove("translate-x-0");
        drawer.classList.add("translate-x-full");
      }
      document.documentElement.classList.remove("overflow-hidden");
    };

    if (openBtn) openBtn.addEventListener("click", openDrawer);
    if (closeBtn) closeBtn.addEventListener("click", closeDrawer);
    if (overlay) overlay.addEventListener("click", closeDrawer);
  });
</script>

<style is:global>
  .booking-submit button {
    width: 100%;
    display: block;
    text-align: center;
  }
</style>
