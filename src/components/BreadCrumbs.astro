---
const { currentPage = "Side", show = true } = Astro.props;
---

<nav
  hidden={!show}
  aria-label="breadcrumbs"
  class="px-2xs md:px-xl pt-2xs md:pt-xs"
>
  <ol class="flex items-center gap-2 text-sm md:text-xl text-text-dark">
    <li>
      <a
        href="/"
        class="hover:underline decoration-current decoration-2 underline-offset-4"
      >
        Home
      </a>
    </li>
    <li aria-hidden="true" class="text-text-dark/40">›</li>
    <li
      aria-current="page"
      class="text-text-dark underline decoration-current decoration-2 underline-offset-4"
    >
      {currentPage}
    </li>
  </ol>
</nav>
