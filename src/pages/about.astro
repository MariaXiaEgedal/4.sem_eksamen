---
import MainLayout from "../layouts/MainLayout.astro";
import Link from "../components/Link.astro";
import { Image } from "astro:assets";
import Heading from "../components/Heading.astro";
import Text from "../components/Text.astro";
import Button from "../components/Button.astro";
import TextImgRight from "../components/TextImgRight.astro";
import TimeLine from "../components/TimeLine.astro";
import Faq from "../components/Faq.astro";
import TextImgLeft from "../components/TextImgLeft.astro";
import Socials from "../components/Socials.astro";
import SectionDivider from "../components/SectionDivider.astro";
---

<MainLayout title="About us">
  <!-- Denne linje under betyder gappet mellem sektioner 40px/mobil og 80px/desktop (Jeg har lavet den)-->
  <!-- flex flex-col gap-s md:gap-l  -->

  <!-- Denne linje under betyder padding på x-aksen 20px/mobil og 100px/desktop (Jeg har lavet den) -->
  <!-- px-2xs md:px-xl -->

  <!-- Denne linje under betyder grid til mobil (4 kolonner) og desktop (12 kolonner) og begge med 20px mellemrum (den skal i bruge hvis designet følger vores grid) -->
  <!-- grid grid-cols-4 md:grid-cols-12 gap-2xs -->
  <main class="my-s md:my-l">
    <div class="flex flex-col gap-s md:gap-l">
      <section class="px-2xs md:px-xl whitespace-pre-line">
        <TextImgRight
          image="/img/aboutusbillede.svg"
          imageAlt="About us billede"
          heading="About us"
          text={`At Pool Cph, everything is created with intention. From the interior and overall visual identity to the bar and what’s being served, every detail has been carefully considered. Nothing is random, everything is chosen to support the feeling of the place. 
          
          Our goal is to create the perfect setting for great nights. Whether you're here to play pool, have a drink, or just hang out, Pool Cph is designed to bring people together and make every visit feel special.`}
        />
      </section>

      <SectionDivider />

      <section class="px-2xs md:px-xl">
        <Heading
          htmlheading="h2"
          size="medium"
          stylingclasses="mb-2xs text-text-dark">The history of pool</Heading
        >
        <TimeLine />
      </section>

      <SectionDivider />

      <section class="px-2xs md:px-xl">
        <Heading
          htmlheading="h2"
          size="medium"
          stylingclasses="mb-2xs text-text-dark">A New Way to Socialize</Heading
        >
        <div class="grid grid-cols-2">
          <div class="p-xs md:p-2xs">
            <Heading
              htmlheading="h2"
              size="small"
              stylingclasses="text-text-dark ">Our Mission</Heading
            >
            <Text teksttype="brødtekst" stylingclasses="text-text-dark">
              We want to create a space that people can relate to at all times
              of the day. Inclusivity is a key value for us, and we feel that
              it’s missing in the scene. Let’s build lasting connections
              together.
            </Text>
          </div>

          <div class="p-xs md:p-2xs">
            <Heading
              htmlheading="h2"
              size="small"
              stylingclasses="text-text-dark ">Community</Heading
            >
            <Text teksttype="brødtekst" stylingclasses="text-text-dark">
              Our vision is to push the boundaries within the industry by
              offering new ways of socializing that go beyond drinking. We’re
              here to provide fun experiences that keep you fresh for the next
              morning.
            </Text>
          </div>
        </div>
      </section>

      <section class="px-2xs md:px-xl">
        <Faq />
      </section>

      <section class="px-2xs md:px-xl whitespace-pre-line no-border">
        <TextImgLeft
          heading="Location"
          text={`You'll find POOL Cph right in the heart of Copenhagen at Gothersgade 8C, 1123 København, tucked away in a cozy and slightly hidden courtyard.
          
          Set back from the busy street, it feels like your own little oasis, offering a more relaxed and private atmosphere.`}
          ctaLabel=""
          mapSrc="https://maps.google.com/maps?q=Gothersgade%208C%2C%201123%20K%C3%B8benhavn&output=embed"
          mapTitle="POOL Cph - Gothersgade 8C"
        />
      </section>

      <SectionDivider />

      <section class="bg-purple-500">
        <p>Socials</p>
        <Heading
          htmlheading="h2"
          size="medium"
          stylingclasses="text-text-dark px-2xs md:px-xl">Socials</Heading
        >
        <Socials />
      </section>
    </div>
  </main>
</MainLayout>
