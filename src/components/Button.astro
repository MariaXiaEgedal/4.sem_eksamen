---
// Henter parametrene fra Astro.props
const {
  variant = "primary",
  size = "medium",
  id,
  class: className = "",
} = Astro.props;
const variantKey = String(variant);
const sizeKey = String(size);
const isToggleVariant = variantKey.startsWith("outline");

// Basale styling (fælles for alle varianter og størrelser)
const base =
  "rounded-xs transition-all duration-300 ease-out flex items-center justify-center";

// Varianter
const variantClasses = {
  primary:
    "bg-cta-primary text-text-light px-xs py-4xs hover:px-m hover:shadow-lg",
  secondary:
    "bg-cta-secondary text-text-dark px-xs py-4xs hover:px-m hover:shadow-lg",
  outline_light:
    "bg-transparent border-2 border-cta-secondary text-text-light px-xs py-4xs [&.active]:bg-cta-secondary [&.active]:text-text-dark",
  outline_dark:
    "bg-transparent border-2 border-cta-primary text-text-dark px-xs py-4xs [&.active]:bg-cta-primary [&.active]:text-text-light",
};

const selectedVariant = variantClasses[variantKey] || variantClasses.primary;

// Størrelse (kun tekst-størrelse)
const sizeClasses = {
  large: "text-[16px] md:text-[22px] font-bold",
  medium: "text-[16px] md:text-[22px]",
  mediumOverlay:
    "text-[16px] md:text-[22px] hover:text-[18px] md:hover:text-[24px]",
  small: "text-[16px] md:text-[18px] font-bold",
};

const selectedSize = sizeClasses[sizeKey] || sizeClasses.medium;
---

<!-- Sæt classes for den pågældende knap sammen ved hjælp af Astros class:list -->
<button
  id={id}
  data-toggle={isToggleVariant}
  class:list={[base, selectedVariant, selectedSize, className]}
>
  <slot />
</button>

<script is:inline define:vars={{ isToggleVariant }}>
  if (isToggleVariant) {
    const initToggle = () => {
      document.querySelectorAll('[data-toggle="true"]').forEach((button) => {
        if (!button.dataset.toggleInit) {
          button.dataset.toggleInit = "true";
          button.addEventListener("click", () => {
            button.classList.toggle("active");
          });
        }
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initToggle);
    } else {
      initToggle();
    }
  }
</script>
