---
import Button from "./Button.astro";
import Heading from "./Heading.astro";
import Text from "./Text.astro";
import Calendar from "./Calendar.astro";
import Counting from "./Counting.astro";

const {
  openButtonText = "Book pool table",
  openButtonVariant = "primary",
  responsiveInBurger = false,
} = Astro.props;
---

<div class="eventbooking-root">
  <!-- Page content -->
  <div>
    {
      responsiveInBurger ? (
        <>
          <Button
            class="eventbooking-open lg:hidden"
            variant="secondary"
            size="medium"
          >
            {openButtonText}
          </Button>

          <Button
            class="eventbooking-open hidden lg:inline-flex"
            variant={openButtonVariant}
            size="medium"
          >
            {openButtonText}
          </Button>
        </>
      ) : (
        <Button
          class="eventbooking-open"
          variant={openButtonVariant}
          size="medium"
        >
          {openButtonText}
        </Button>
      )
    }
  </div>

  <div class="eventbooking-portal">
    <!-- Overlay -->
    <div
      class="eventbooking-overlay fixed inset-0 z-[1000] opacity-0 transition-opacity duration-500 ease-out pointer-events-none"
      style="background-color: rgba(0, 0, 0, 0.5);"
    >
    </div>

    <!-- Sidebar -->
    <div
      class="eventbooking-side bg-background-secondary fixed right-0 top-0 h-full w-full md:w-1/2 pt-s px-2xs md:px-m lg:px-l z-[1010] transform translate-x-full transition-transform duration-500 ease-in-out overflow-y-auto"
    >
      <!-- Topbar: centered logo with close button on same line -->
      <div class="relative mb-xs md:mb-s">
        <button
          class="eventbooking-close absolute right-0 top-0 text-3xl text-text-light"
          type="button">✕</button
        >
        <div class="flex justify-center">
          <img
            src="/img/logo-pool-hvid.svg"
            alt="Pool Logo"
            class="h-14 w-auto"
          />
        </div>
      </div>

      <!-- Calendar -->
      <div class="mb-xs md:mb-s">
        <Calendar />
      </div>

      <!-- Prices  -->
      <div class="mb-2xs md:mb-xs">
        <Heading
          htmlheading="h5"
          size="xsmallbold"
          stylingclasses="text-text-light mb-5xs">Prices: (30 min)</Heading
        >
        <Text teksttype="brødtekst-lille" stylingclasses="text-text-light">
          Monday - Wednesday: DKK 75 pr. 30 min <br /> Thursday - Saturday: DKK 100
          pr. 30 min
        </Text>
      </div>

      <!-- Table time -->
      <div class="mb-2xs md:mb-xs">
        <Heading
          htmlheading="h5"
          size="xsmallbold"
          stylingclasses="text-text-light mb-5xs">Table time</Heading
        >
        <Text
          teksttype="brødtekst"
          stylingclasses="text-text-light mb-4xs md:mb-2xs"
        >
          Choose how long you’d like to play
        </Text>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4xs md:gap-2xs">
          <Button class="w-full" variant="outline_light" size="small"
            >30 min</Button
          >
          <Button class="w-full" variant="outline_light" size="small"
            >60 min</Button
          >
          <Button class="w-full" variant="outline_light" size="small"
            >90 min</Button
          >
          <Button class="w-full" variant="outline_light" size="small"
            >120 min</Button
          >
        </div>
      </div>

      <div
        class="grid grid-cols-1 lg:grid-cols-2 gap-0 lg:gap-2xs mb-2xs md:mb-xs"
      >
        <!-- Guests -->
        <div class="min-w-0 mb-2xs md:mb-xs">
          <Heading
            htmlheading="h5"
            size="xsmallbold"
            stylingclasses="text-text-light mb-5xs">Guests</Heading
          >
          <Text teksttype="brødtekst" stylingclasses="text-text-light mb-5xs">
            Select number of guests
          </Text>
          <Text
            teksttype="brødtekst-lille"
            stylingclasses="text-text-light mb-4xs md:mb-2xs"
          >
            (For more than 12 guests, please contact us)
          </Text>
          <div class="flex justify-start">
            <Counting />
          </div>
        </div>

        <!-- Time -->
        <div class="min-w-0">
          <Heading
            htmlheading="h5"
            size="xsmallbold"
            stylingclasses="text-text-light mb-5xs">Time</Heading
          >
          <Text
            teksttype="brødtekst"
            stylingclasses="text-text-light mb-2xs md:mb-xs"
          >
            Available times:
          </Text>
          <div class="grid grid-cols-3 gap-4xs md:gap-2xs">
            <Button class="w-full" variant="outline_light" size="small"
              >16:00</Button
            >
            <Button class="w-full" variant="outline_light" size="small"
              >16:30</Button
            >
            <Button class="w-full" variant="outline_light" size="small"
              >17:00</Button
            >
            <Button class="w-full" variant="outline_light" size="small"
              >17:30</Button
            >
            <Button class="w-full" variant="outline_light" size="small"
              >18:00</Button
            >
            <Button class="w-full" variant="outline_light" size="small"
              >18:30</Button
            >
            <Button class="w-full" variant="outline_light" size="small"
              >19:00</Button
            >
            <Button class="w-full" variant="outline_light" size="small"
              >19:30</Button
            >
            <Button class="w-full" variant="outline_light" size="small"
              >20:00</Button
            >
          </div>
        </div>
      </div>

      <!-- Continue Booking Button -->
      <div>
        <Button class="w-full gap-2" variant="secondary" size="mediumOverlay">
          <span>Continue Booking</span>
          <img src="/img/piltilhøjre.svg" alt="" aria-hidden="true" />
        </Button>
      </div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll(".eventbooking-root").forEach((root) => {
    const portal = root.querySelector(".eventbooking-portal");
    if (!portal) return;
    if (portal.parentElement !== document.body)
      document.body.appendChild(portal);
    const overlay = portal.querySelector(".eventbooking-overlay"),
      drawer = portal.querySelector(".eventbooking-side");
    const open = () => {
      overlay?.classList.remove("pointer-events-none");
      overlay?.classList.add("opacity-100");
      drawer?.classList.remove("translate-x-full");
      drawer?.classList.add("translate-x-0");
      document.documentElement.classList.add("overflow-hidden");
    };
    const close = () => {
      overlay?.classList.remove("opacity-100");
      overlay?.classList.add("pointer-events-none");
      drawer?.classList.remove("translate-x-0");
      drawer?.classList.add("translate-x-full");
      document.documentElement.classList.remove("overflow-hidden");
    };
    root.querySelectorAll(".eventbooking-open").forEach((btn) => {
      if (btn instanceof HTMLElement && !btn.dataset.bs) {
        btn.dataset.bs = "1";
        btn.addEventListener("click", open);
      }
    });
    const closeBtn = portal.querySelector(".eventbooking-close");
    if (closeBtn instanceof HTMLElement && !closeBtn.dataset.bs) {
      closeBtn.dataset.bs = "1";
      closeBtn.addEventListener("click", close);
    }
    if (overlay instanceof HTMLElement && !overlay.dataset.bs) {
      overlay.dataset.bs = "1";
      overlay.addEventListener("click", close);
    }
  });
</script>
